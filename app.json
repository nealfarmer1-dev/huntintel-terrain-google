{
  "expo": {
    "name": "HuntIntel Terrain Google",
    "slug": "huntintel-terrain-google",
    "version": "0.1.4",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020706"
    },
    "plugins": [
      "react-native-iap",
      [
        "expo-image-picker",
        {
          "cameraPermission": "HuntIntel Terrain uses the camera only when you choose to capture a field photo or video.",
          "photosPermission": "HuntIntel Terrain accesses a selected field photo or video only when you choose it.",
          "microphonePermission": "HuntIntel Terrain uses the microphone only when you choose to record field video."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "HuntIntel Terrain uses the microphone only when you choose to record a voice note."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HuntIntel Terrain uses your location only when you activate navigation or opt in to live SAR sharing.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-asset"
    ],
    "android": {
      "package": "com.huntintel.terrainintelligence",
      "edgeToEdgeEnabled": true,
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#020706"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "657bae20-cff3-4bce-9a36-3037a179d586"
      }
    }
  }
}
